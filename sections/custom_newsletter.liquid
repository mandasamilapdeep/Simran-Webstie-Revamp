<!-- /sections/custom_newsletter.liquid -->
{%- liquid
  assign unique = section.id
  assign form_id = 'Newsletter--' | append: unique
  assign animation_anchor = '#CustomNewsletter--' | append: unique

  assign subheading = section.settings.subheading
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign bg_image = section.settings.bg_image
  assign bg_color = section.settings.bg_color | default: '#f4efea'
  assign card_bg_color = section.settings.card_bg_color | default: '#ffffff'
  assign subheading_color = section.settings.subheading_color | default: '#8a7d71'
  assign heading_color = section.settings.heading_color | default: '#2b1e19'
  assign text_color = section.settings.text_color | default: '#6f6b6a'
  assign button_bg_color = section.settings.button_bg_color | default: '#251d12'
  assign button_text_color = section.settings.button_text_color | default: '#ffffff'
  assign input_line_color = section.settings.input_line_color | default: '#251d12'
  assign input_label_color = section.settings.input_label_color | default: '#777777'

  assign subheading_size = section.settings.subheading_size | default: 1
  assign heading_size = section.settings.heading_size | default: 7
  assign text_size = section.settings.text_size | default: 3
  assign customer_tags = section.settings.customer_tags | default: 'Free guide, newsletter'
-%}

{%- style -%}
  #CustomNewsletter--{{ unique }} {
    --newsletter-subheading-color: {{ subheading_color }};
    --newsletter-heading-color: {{ heading_color }};
    --newsletter-text-color: {{ text_color }};
    --newsletter-card-bg: {{ card_bg_color }};
    --newsletter-btn-bg: {{ button_bg_color }};
    --newsletter-btn-text: {{ button_text_color }};
    --newsletter-line-color: {{ input_line_color }};
    --newsletter-label-color: {{ input_label_color }};
    --newsletter-pt: {{ section.settings.padding_top | default: 60 }}px;
    --newsletter-pb: {{ section.settings.padding_bottom | default: 60 }}px;
    --newsletter-min-height: {{ section.settings.min_height | default: 500 }}px;
    --newsletter-card-max-width: {{ section.settings.card_max_width | default: 480 }}px;
    background-color: {{ bg_color }};
    {%- if bg_image != blank -%}
      background-image: url('{{ bg_image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    {%- endif -%}
  }

  {%- if heading_size > 16 -%}
    #CustomNewsletter--{{ unique }} .custom-newsletter__heading {
      font-size: {{ heading_size }}px;
    }
  {%- endif -%}

  {%- if subheading_size > 15 -%}
    #CustomNewsletter--{{ unique }} .custom-newsletter__subheading {
      font-size: {{ subheading_size }}px;
    }
  {%- endif -%}

  {%- if text_size > 15 -%}
    #CustomNewsletter--{{ unique }} .custom-newsletter__text,
    #CustomNewsletter--{{ unique }} .custom-newsletter__text p {
      font-size: {{ text_size }}px;
    }
  {%- endif -%}
{%- endstyle -%}

<style>
  .custom-newsletter {
    position: relative;
    width: 100%;
    min-height: var(--newsletter-min-height, 480px);
    padding-top: var(--newsletter-pt, 60px);
    padding-bottom: var(--newsletter-pb, 60px);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    overflow: hidden;
  }

  .custom-newsletter__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .custom-newsletter__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .custom-newsletter__container {
    position: relative;
    z-index: 2;
    width: 100%;
    margin: 0 auto;
    display: flex;
    box-sizing: border-box;
  }

  .custom-newsletter__container--left {
    justify-content: flex-start;
  }

  .custom-newsletter__container--center {
    justify-content: center;
  }

  .custom-newsletter__container--right {
    justify-content: flex-end;
  }

  .custom-newsletter__card {
    background-color: var(--newsletter-card-bg, #ffffff);
    width: 100%;
    max-width: var(--newsletter-card-max-width, 480px);
    padding: 44px 40px 40px;
    box-sizing: border-box;
    border-radius: 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .custom-newsletter__subheading {
    font-family: var(--FONT-STACK-SUBHEADING, inherit);
    font-style: var(--FONT-STYLE-SUBHEADING, normal);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--newsletter-subheading-color, #8a7d71);
    margin: 0 0 16px 0;
    line-height: 1.3;
  }

  .custom-newsletter__heading {
    color: var(--newsletter-heading-color, #2b1e19);
  }

  .custom-newsletter__text {
    font-family: var(--FONT-STACK-BODY, inherit);
    font-style: var(--FONT-STYLE-BODY, normal);
    line-height: 1.6;
    color: var(--newsletter-text-color, #6f6b6a);
    margin: 0 0 28px 0;
  }

  .custom-newsletter__text:not([class*='body-size-']) {
    font-size: 13px;
  }

  .custom-newsletter__text p {
    margin: 0;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .custom-newsletter__form-wrapper {
    width: 100%;
  }

  .custom-newsletter__form {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .custom-newsletter__form-row {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    width: 100%;
  }

  .custom-newsletter__field-wrap {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
  }

  .custom-newsletter__label {
    display: block;
    font-family: var(--FONT-STACK-BODY, inherit);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--newsletter-label-color, #777777);
    margin: 0 0 6px 0;
    line-height: 1;
    cursor: pointer;
  }

  .custom-newsletter__input {
    display: block;
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--newsletter-line-color, #251d12);
    border-radius: 0;
    background: transparent;
    padding: 4px 0 8px 0;
    font-family: var(--FONT-STACK-BODY, inherit);
    font-size: 13px;
    line-height: 1.3;
    color: var(--newsletter-heading-color, #2b1e19);
    box-sizing: border-box;
    outline: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    box-shadow: none;
    transition: border-color 0.2s ease;
  }

  .custom-newsletter__input:focus {
    border-bottom-width: 1.5px;
    border-bottom-color: var(--newsletter-heading-color, #2b1e19);
    outline: none;
    box-shadow: none;
  }

  .custom-newsletter__message {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.5;
  }

  .custom-newsletter__message--success {
    color: var(--newsletter-heading-color, #2b1e19);
    font-weight: 500;
  }

  .custom-newsletter__message--error {
    color: #cc0000;
  }

  @media screen and (max-width: 749px) {
    .custom-newsletter {
      min-height: auto;
      padding-top: calc(var(--newsletter-pt, 60px) * 0.7);
      padding-bottom: calc(var(--newsletter-pb, 60px) * 0.7);
    }

    .custom-newsletter__card {
      padding: 32px 24px 28px;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 480px) {
    .custom-newsletter__form-row {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
  }
</style>

<section
  id="CustomNewsletter--{{ unique }}"
  class="custom-newsletter {{ section.settings.width }}"
  data-section-id="{{ unique }}"
  data-section-type="custom-newsletter"
>
  {%- if bg_image != blank -%}
    <div class="custom-newsletter__bg" aria-hidden="true">
      {{
        bg_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          class: 'custom-newsletter__bg-img',
          alt: bg_image.alt
        | default: heading
        | strip_html
        | escape
      }}
    </div>
  {%- endif -%}

  <div class="custom-newsletter__container custom-newsletter__container--{{ section.settings.card_alignment | default: 'left' }}">
    <div
      class="custom-newsletter__card"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
    >
      {%- if subheading != blank -%}
        <p
          class="custom-newsletter__subheading heading-size-{{ subheading_size }}"
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="1"
        >
          {{ subheading | escape }}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2
          class="custom-newsletter__heading heading-size-{{ heading_size }}"
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="2"
        >
          {{ heading | newline_to_br }}
        </h2>
      {%- endif -%}

      {%- if text != blank -%}
        <div
          class="custom-newsletter__text body-size-{{ text_size }}"
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="3"
        >
          {{ text }}
        </div>
      {%- endif -%}

      <div
        class="custom-newsletter__form-wrapper"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="4"
      >
        {%- form 'customer', id: form_id, class: 'custom-newsletter__form' -%}
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          {%- assign tags_to_pass = customer_tags | strip -%}
          {%- if tags_to_pass != blank -%}
            <input type="hidden" name="contact[tags]" value="{{ tags_to_pass | escape }}">
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div
              class="custom-newsletter__message custom-newsletter__message--success"
              id="Newsletter-success--{{ unique }}"
              role="status"
              tabindex="-1"
              autofocus
            >
              <p>
                {{
                  section.settings.success_text
                  | default: 'Thank you for subscribing! Sent straight to your inbox.'
                  | escape
                }}
              </p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div
                class="custom-newsletter__message custom-newsletter__message--error"
                id="Newsletter-error--{{ unique }}"
                role="alert"
              >
                <p>
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              </div>
            {%- endif -%}

            <div class="custom-newsletter__form-row">
              <div class="custom-newsletter__field-wrap">
                {%- if section.settings.input_label != blank -%}
                  <label for="NewsletterEmail--{{ unique }}" class="custom-newsletter__label">
                    {{ section.settings.input_label | escape }}
                  </label>
                {%- endif -%}
                <input
                  type="email"
                  id="NewsletterEmail--{{ unique }}"
                  name="contact[email]"
                  class="custom-newsletter__input"
                  value="{% if customer %}{{ customer.email }}{% endif %}"
                  aria-label="{{ section.settings.input_label | default: 'EMAIL ADDRESS' | escape }}"
                  placeholder=""
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="Newsletter-error--{{ unique }}"
                  {% endif %}
                >
              </div>

              <button
                type="submit"
                name="commit"
                id="NewsletterSubmit--{{ unique }}"
                class="btn btn--solid btn--large btn--secondary "
                aria-label="{{ section.settings.button_text | default: 'SEND ME THE GUIDE' | escape }}"
              >
                <span>{{ section.settings.button_text | default: 'SEND ME THE GUIDE' | escape }}</span>
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        { "value": "wrapper--full-padded", "label": "Full width padded" },
        { "value": "wrapper", "label": "Normal" }
      ]
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FREE GUIDE"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading font size",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 1
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#8A7D71"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The Commercial Fit-Out Planning\nGuide."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 7
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2B1E19"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>What to budget for, what to ask your landlord and how long each stage really takes. Sent straight to your inbox.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description font size",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#6F6B6A"
    },
    {
      "type": "header",
      "content": "Customer Tags & Form"
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Customer tags",
      "default": "Free guide, newsletter",
      "info": "Comma-separated tags added to subscriber profile in Shopify (e.g. 'newsletter', 'Free guide')."
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Email field label",
      "default": "EMAIL ADDRESS"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SEND ME THE GUIDE"
    },
    {
      "type": "color",
      "id": "input_line_color",
      "label": "Input underline color",
      "default": "#251D12"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#251D12"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you for subscribing! Sent straight to your inbox."
    },
    {
      "type": "header",
      "content": "Card Style & Layout"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_max_width",
      "label": "Card max width",
      "min": 360,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 480
    },
    {
      "type": "header",
      "content": "Background & Spacing"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F4EFEA"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum section height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Custom Newsletter",
      "category": "Newsletter"
    }
  ]
}
{% endschema %}
