{% style %}
  .table_section_{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="table_section {{ section.settings.width }} table_section_{{ section.id }}">
  <div class="table-section-inner">
    <div class="table-section-blocks-wrapper">
      {% for block in section.blocks %}
        <div
          {{ block.shopify_attributes }}
          style="
            {% if block.settings.table_column_border_bottom != blank %}
            border-bottom: 1px solid {{ block.settings.table_column_border_bottom }};
            {% endif %}
             margin-bottom: {{ block.settings.table_column_margin_bottom }}px; padding-bottom: {{ block.settings.table_column_bottom_padding }}px;
          "
          class="table_column"
          data-aos="hero"
          data-aos-order="{{ forloop.index }}"
        >
          <div class="table_column_content">
            <div class="table_column_content_row">
              {% if block.settings.first_title != blank %}
                <div
                  style="text-align: {{ block.settings.first_title_align }}; color: {{ block.settings.first_title_color }}; letter-spacing: {{ block.settings.first_title_letter_spacing }}px;"
                  class="table_column_content_row_title body-size-{{ block.settings.first_title_size }}"
                >
                  {{ block.settings.first_title }}
                </div>
              {% endif %}
              {% if block.settings.first_text != blank %}
                <div
                  style="text-align: {{ block.settings.first_text_align }}; color: {{ block.settings.first_text_color }}; letter-spacing: {{ block.settings.first_text_letter_spacing }}px;"
                  class="table_column_content_row_text body-size-{{ block.settings.first_text_size }}"
                >
                  {{ block.settings.first_text }}
                </div>
              {% endif %}
            </div>
            <div class="table_column_content_row">
              {% if block.settings.second_title != blank %}
                <div
                  style="text-align: {{ block.settings.second_title_align }}; color: {{ block.settings.second_title_color }}; letter-spacing: {{ block.settings.second_title_letter_spacing }}px;"
                  class="table_column_content_row_title body-size-{{ block.settings.second_title_size }}"
                >
                  {{ block.settings.second_title }}
                </div>
              {% endif %}
              {% if block.settings.second_text != blank %}
                <div
                  style="text-align: {{ block.settings.second_text_align }}; color: {{ block.settings.second_text_color }}; letter-spacing: {{ block.settings.second_text_letter_spacing }}px;"
                  class="table_column_content_row_text body-size-{{ block.settings.second_text_size }}"
                >
                  {{ block.settings.second_text }}
                </div>
              {% endif %}
            </div>
            <div class="table_column_content_row">
              {% if block.settings.third_title != blank %}
                <div
                  style="text-align: {{ block.settings.third_title_align }}; color: {{ block.settings.third_title_color }}; letter-spacing: {{ block.settings.third_title_letter_spacing }}px;"
                  class="table_column_content_row_title body-size-{{ block.settings.third_title_size }}"
                >
                  {{ block.settings.third_title }}
                </div>
              {% endif %}
              {% if block.settings.third_text != blank %}
                <div
                  style="text-align: {{ block.settings.third_text_align }}; color: {{ block.settings.third_text_color }}; letter-spacing: {{ block.settings.third_text_letter_spacing }}px;"
                  class="table_column_content_row_text body-size-{{ block.settings.third_text_size }}"
                >
                  {{ block.settings.third_text }}
                </div>
              {% endif %}
            </div>
            <div class="table_column_content_row">
              {% if block.settings.fourth_title != blank %}
                <div
                  style="text-align: {{ block.settings.fourth_title_align }}; color: {{ block.settings.fourth_title_color }}; letter-spacing: {{ block.settings.fourth_title_letter_spacing }}px;"
                  class="table_column_content_row_title body-size-{{ block.settings.fourth_title_size }}"
                >
                  {{ block.settings.fourth_title }}
                </div>
              {% endif %}
              {% if block.settings.fourth_text != blank %}
                <div
                  style="text-align: {{ block.settings.fourth_text_align }}; color: {{ block.settings.fourth_text_color }}; letter-spacing: {{ block.settings.fourth_text_letter_spacing }}px;"
                  class="table_column_content_row_text body-size-{{ block.settings.fourth_text_size }}"
                >
                  {{ block.settings.fourth_text }}
                </div>
              {% endif %}
            </div>
            <div class="table_column_content_row">
              {% if block.settings.fifth_title != blank %}
                <div
                  style="text-align: {{ block.settings.fifth_title_align }}; color: {{ block.settings.fifth_title_color }}; letter-spacing: {{ block.settings.fifth_title_letter_spacing }}px;"
                  class="table_column_content_row_title body-size-{{ block.settings.fifth_title_size }}"
                >
                  {{ block.settings.fifth_title }}
                </div>
              {% endif %}
              {% if block.settings.fifth_text != blank %}
                <div
                  style="text-align: {{ block.settings.fifth_text_align }}; color: {{ block.settings.fifth_text_color }}; letter-spacing: {{ block.settings.fifth_text_letter_spacing }}px;"
                  class="table_column_content_row_text body-size-{{ block.settings.fifth_text_size }}"
                >
                  {{ block.settings.fifth_text }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

