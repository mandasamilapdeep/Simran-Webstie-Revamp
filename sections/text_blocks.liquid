{% style %}
  #{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media(max-width:780px){
    #{{ section.id }} {
    padding-top: {{ section.settings.padding_top |times : 0.6 }}px;
    padding-bottom: {{ section.settings.padding_bottom |times : 0.6 }}px;
  }
  }
{% endstyle %}

{%- liquid
  assign heading = section.settings.title
  assign unique = 'SectionColumns--' | append: section.id
  assign animation_order = 0
  assign animation_anchor = unique | prepend: '#'

  assign font_size_class = section.settings.heading_size | prepend: 'heading-size-'
-%}

<div
  id="{{ section.id }}"
  style="background: {{ section.settings.bg_color }}; color: {{ section.settings.color }};"
  class="{{ section.settings.width }} {{ section.settings.align_text }} text_blocks_main"
>
  {% if heading != blank %}
    <div class="title_box">
      <h2
        style="color: {{ section.settings.title_color }};letter-spacing: {{ section.settings.heading_letter_spacing }}px;"
        class="grid__heading {{ font_size_class }}"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >
        {{- heading -}}
      </h2>
    </div>
  {% endif %}

  <div
    style="
      {%- if section.settings.blocks_border_top != blank -%}
        border-top: 1px solid {{ section.settings.blocks_border_top }};
      {%- endif -%}
      {%- if section.settings.blocks_border_bottom != blank -%}
        border-bottom: 1px solid {{ section.settings.blocks_border_bottom }};
      {%- endif -%}
    "
    class="text_blocks_main_inner"
  >
    {% for block in section.blocks %}
      {%- assign animation_order = animation_order | plus: 1 -%}
      {% if block.type == 'text' %}
        {% style %}
          @media screen and (min-width: 750px) {
            #{{ section.id }} .text_block_{{ section.id }}_{{ block.id }} {
              grid-template-columns: repeat({{ block.settings.show_desktop_columns_one_row }}, minmax(0, 1fr));
            }
          }
        {% endstyle %}
        <div
          {{ block.shopify_attributes }}
          class="text_block text_block_{{ section.id }}_{{ block.id }} {{ section.settings.align_text_blocks }}"
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="{{ animation_order }}"
        >
          {% if block.settings.heading_1 != blank or block.settings.subheading_1 != blank %}
            <div class="text_block_inner_single">
              {% if block.settings.heading_1 != blank %}
                <h4 class="grid__heading heading-size-{{ section.settings.block_heading_size }}">
                  {{- block.settings.heading_1 -}}
                </h4>
              {% endif %}
              {% if block.settings.subheading_1 != blank %}
                <p class="body-size-{{ section.settings.block_subheading_size }}">
                  {{- block.settings.subheading_1 -}}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.heading_2 != blank or block.settings.subheading_2 != blank %}
            <div class="text_block_inner_single">
              {% if block.settings.heading_2 != blank %}
                <h4 class="grid__heading heading-size-{{ section.settings.block_heading_size }}">
                  {{- block.settings.heading_2 -}}
                </h4>
              {% endif %}
              {% if block.settings.subheading_2 != blank %}
                <p class="body-size-{{ section.settings.block_subheading_size }}">
                  {{- block.settings.subheading_2 -}}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.heading_3 != blank or block.settings.subheading_3 != blank %}
            <div class="text_block_inner_single">
              {% if block.settings.heading_3 != blank %}
                <h4 class="grid__heading heading-size-{{ section.settings.block_heading_size }}">
                  {{- block.settings.heading_3 -}}
                </h4>
              {% endif %}
              {% if block.settings.subheading_3 != blank %}
                <p class="body-size-{{ section.settings.block_subheading_size }}">
                  {{- block.settings.subheading_3 -}}
                </p>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.heading_4 != blank or block.settings.subheading_4 != blank %}
            <div class="text_block_inner_single">
              {% if block.settings.heading_4 != blank %}
                <h4 class="grid__heading heading-size-{{ section.settings.block_heading_size }}">
                  {{- block.settings.heading_4 -}}
                </h4>
              {% endif %}
              {% if block.settings.subheading_4 != blank %}
                <p class="body-size-{{ section.settings.block_subheading_size }}">
                  {{- block.settings.subheading_4 -}}
                </p>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.heading_5 != blank or block.settings.subheading_5 != blank %}
            <div class="text_block_inner_single">
              {% if block.settings.heading_5 != blank %}
                <h4 class="grid__heading heading-size-{{ section.settings.block_heading_size }}">
                  {{- block.settings.heading_5 -}}
                </h4>
              {% endif %}
              {% if block.settings.subheading_5 != blank %}
                <p class="body-size-{{ section.settings.block_subheading_size }}">
                  {{- block.settings.subheading_5 -}}
                </p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.content != blank %}
    <div
      class="content-wrapper"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-order="{{ animation_order }}"
    >
      <p class="body-size-{{ section.settings.content_size }} ">{{- section.settings.content -}}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "Text Blocks",
  "class": "index-section",
  "settings": [
    {
      "type": "select",
      "id": "align_text",
      "label": "Align text",
      "default": "text-left",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "select",
      "id": "align_text_blocks",
      "label": "Align text blocks",
      "default": "text-left",
      "options": [
        {
          "value": "text-left",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -5,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Content size",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "block_heading_size",
      "label": "Block heading size",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "block_subheading_size",
      "label": "Block sub heading size",
      "min": 1,
      "max": 15,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        { "value": "wrapper--full-padded", "label": "Full width padded" },
        { "value": "wrapper", "label": "Normal" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "blocks_border_top",
      "label": "Blocks border top"
    },
    {
      "type": "color",
      "id": "blocks_border_bottom",
      "label": "Blocks border bottom"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "range",
          "id": "show_desktop_columns_one_row",
          "min": 2,
          "max": 5,
          "step": 1,
          "label": "Show desktop columns one row",
          "default": 5
        },
        {
          "type": "text",
          "id": "heading_1",
          "label": "Title_1",
          "default": "Tab title"
        },
        {
          "type": "text",
          "id": "subheading_1",
          "label": "Sub heading_1",
          "default": "Tab sub heading 1"
        },
        {
          "type": "text",
          "id": "heading_2",
          "label": "Title_2",
          "default": "Tab title"
        },
        {
          "type": "text",
          "id": "subheading_2",
          "label": "Sub heading_2",
          "default": "Tab sub heading 2"
        },
        {
          "type": "text",
          "id": "heading_3",
          "label": "Title_3",
          "default": "Tab title"
        },
        {
          "type": "text",
          "id": "subheading_3",
          "label": "Sub heading_3",
          "default": "Tab sub heading 3"
        },
        {
          "type": "text",
          "id": "heading_4",
          "label": "Title_4",
          "default": "Tab title"
        },
        {
          "type": "text",
          "id": "subheading_4",
          "label": "Sub heading_4",
          "default": "Tab sub heading 4"
        },
        {
          "type": "text",
          "id": "heading_5",
          "label": "Title_5",
          "default": "Tab title"
        },
        {
          "type": "text",
          "id": "subheading_5",
          "label": "Sub heading_5",
          "default": "Tab sub heading 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Blocks",
      "category": "Text",
      "blocks": [
        {
          "type": "text"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
