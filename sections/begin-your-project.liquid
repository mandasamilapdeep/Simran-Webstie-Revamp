                background: #2b1e19;
                color: #ffffff;
                font-family: Jost, sans-serif;
                font-size: 12px;
                letter-spacing: 0.22em;
                text-transform: uppercase;
                display: flex;
                gap: 40px;
                align-items: center;
              "
            >
              Request my call back<span aria-hidden="true">→</span>
            </button>
          </div>
          <div
            class="q-step"
            data-step="7"
            style="flex-direction: column; gap: 28px"
          >
            <span
              style="
                font-size: 12px;
                letter-spacing: 0.24em;
                text-transform: uppercase;
                color: #7a5f32;
              "
              >Request received</span
            >
            <h1
              class="r-display"
              style="
                margin: 0px;
                font-weight: 300;
                font-size: 52px;
                line-height: 1.1;
                letter-spacing: -0.015em;
              "
            >
              Thank you<span id="q-name-out"></span>. We'll call you within one working day.
            </h1>
            <p
              style="
                margin: 0px;
                font-size: 17px;
                line-height: 1.7;
                font-weight: 300;
                color: #574840;
                max-width: 600px;
              "
            >
              Simran will personally review your answers before calling, so the conversation starts with ideas, not
              questions. A copy of your answers is on its way to your inbox.
            </p>
            <div
              class="r-grid"
              style="
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
                padding-top: 8px;
              "
            >
              <a
                href="https://calendly.com/"
                data-note="Replace with your Calendly link"
                style="
                  padding: 28px;
                  background: #2b1e19;
                  color: #ffffff;
                  display: flex;
                  flex-direction: column;
                  gap: 10px;
                "
                ><span
                  style="
                    font-size: 11px;
                    letter-spacing: 0.22em;
                    text-transform: uppercase;
                    color: #cbb68c;
                  "
                  >Skip the wait</span
                ><span style="font-size: 20px">Choose a call time now</span
                ><span
                  style="
                    font-size: 12px;
                    letter-spacing: 0.22em;
                    text-transform: uppercase;
                    text-decoration: underline;
                  "
                  >Open calendar</span
                ></a
              ><a
                href="/pages/case-studies"
                style="
                  padding: 28px;
                  border: 1px solid #2b1e19;
                  display: flex;
                  flex-direction: column;
                  gap: 10px;
                "
                ><span
                  style="
                    font-size: 11px;
                    letter-spacing: 0.22em;
                    text-transform: uppercase;
                    color: #7a5f32;
                  "
                  >While you wait</span
                ><span style="font-size: 20px">See projects like yours</span
                ><span
                  style="
                    font-size: 12px;
                    letter-spacing: 0.22em;
                    text-transform: uppercase;
                    text-decoration: underline;
                  "
                  ><span id="q-sector-link">View case studies</span></span
                ></a
              >
            </div>
            <button
              type="button"
              id="q-restart"
              style="
                align-self: flex-start;
                background: none;
                border: 0px;
                padding: 0px;
                min-height: 44px;
                cursor: pointer;
                font-family: Jost, sans-serif;
                font-size: 13px;
                color: #6b5a50;
                text-decoration: underline;
              "
            >
              Start again
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

