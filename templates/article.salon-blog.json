    "section_rich_text_7Lb9dX": {
      "type": "section-rich-text",
      "blocks": {
        "text_yJ7qgd": {
          "type": "text",
          "settings": {
            "text": "<h4>1. <strong>Designing the Vision</strong></h4>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 20
          }
        },
        "text_VQhBG3": {
          "type": "text",
          "settings": {
            "text": "<p>The client came to us with an old Chinese takeaway shop that was a blank canvas ready to transform into a spa-like salon. </p><p>Our role was to provide mood boards, a material palette, precise floor plans, joinery drawings and high-quality 3D visuals that captured the mood, flow, and function of the salon – giving the client a clear roadmap to execute with their contractors.</p>",
            "text_size": 3,
            "text_style": "font-body",
            "padding_bottom": 16
          }
        }
      },
