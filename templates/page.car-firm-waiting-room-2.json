        "text_MD4BBA": {
          "type": "text",
          "settings": {
            "text": "<ul><li> Retro arcade games coffee table and darts board</li><li> Hidden remote control projector screen</li><li>Custom media wall, radiator cover and planter boxes </li><li>Bespoke island with integrated power points, hidden wine racks and a 138Ltr fridge</li></ul><p>Photography credit: Gary Summers, SMD Photography</p>",
