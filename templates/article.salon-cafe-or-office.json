      "blocks": {
        "text_twdhKP": {
          "type": "text",
          "settings": {
            "text": "<p>Welcome to the very first post on the <strong>Simran Design Ltd</strong> blog! </p><p></p><p>Whether you're a business owner looking to transform your space, or someone who loves all things design, this space is where we share our creative process, real project journeys, behind-the-scenes moments, and industry insights.</p><p>In this post, we’re kicking things off with a quick-fire <strong>5-point introduction</strong> to who we are, what we’ve been up to, and what to expect from this blog going forward.</p>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 16
          }
        }
      },
      "block_order": [
        "text_twdhKP"
