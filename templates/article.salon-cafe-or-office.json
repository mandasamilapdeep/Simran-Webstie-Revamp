    "section_rich_text_7XbMG6": {
      "type": "section-rich-text",
      "blocks": {
        "text_iFjgpq": {
          "type": "text",
          "settings": {
            "text": "<h2>3. Our Design Approach</h2><p>At Simran Design, we believe that every commercial space should <em>do more than just look good</em>. It should:</p><ul><li><strong>Tell a story</strong> about the brand</li><li><strong>Elevate functionality</strong> for both staff and customers</li><li><strong>Create emotion</strong>, connection and memorability</li></ul><p>Our aesthetic leans toward modern luxury -mixing warm textures, clever layouts, refined details, and timeless colour palettes. Each project is tailored, whether we’re transforming a café into a day-to-night destination or refining a boardroom for high-level meetings.</p>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 16
          }
        }
      },
      "block_order": [
        "text_iFjgpq"
      ],
      "name": "Rich text",
      "settings": {
        "width": "wrapper",
        "align_text": "text-left",
