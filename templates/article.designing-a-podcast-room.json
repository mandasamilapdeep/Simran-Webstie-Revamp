      "blocks": {
        "text_y6VpDj": {
          "type": "text",
          "settings": {
            "text": "<h4>5. The Result: A Studio Ready for the Spotlight</h4><p></p>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 10
          }
        },
        "text_NdfELf": {
          "type": "text",
          "settings": {
            "text": "<p>This podcast room isn’t just a box with sound panels. It’s a <strong>professional-grade, fully branded, acoustically designed</strong> space that:</p><p>༶ Records studio-quality audio</p><p>༶ Looks powerful on camera</p><p>༶ Flexes for new users and brands</p><p>༶ Supports Darbar’s mission to elevate Indian Classical Music in the UK</p><p>It proves that with the right strategy, small spaces can deliver big impact.</p>",
            "text_size": 3,
            "text_style": "font-body",
            "padding_bottom": 0
          }
        }
      },
