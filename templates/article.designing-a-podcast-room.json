    "section_rich_text_6fbNzN": {
      "type": "section-rich-text",
      "blocks": {
        "text_xT3htA": {
          "type": "text",
          "settings": {
            "text": "<h4>2. The Interior Design Direction: Where Function Meets Flair</h4>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 20
          }
        },
        "text_TTRkwU": {
          "type": "text",
          "settings": {
            "text": "<p>Our London design team crafted a modern, elevated scheme using:</p><p>༶ A bold <strong>yellow accent palette</strong> echoing surrounding rooms</p><p>༶ <strong>Milliken acoustic carpet tiles</strong> for sound clarity and warmth</p><p>༶ <strong>Allsfar Ora acoustic wall panels</strong> for both design and performance</p><p>༶ Flexible furniture layout with discreet <strong>electrical access</strong> and <strong>camera zones</strong></p><p>Want to see the full vision?</p>",
            "text_size": 3,
            "text_style": "font-body",
            "padding_bottom": 16
          }
        },
        "buttons_Uq4ULV": {
          "type": "buttons",
          "settings": {
