    "section_rich_text_7Lb9dX": {
      "type": "section-rich-text",
      "blocks": {
        "text_yJ7qgd": {
          "type": "text",
          "settings": {
            "text": "<h4>1. The Vision: Versatile, On-Brand, High-Performance</h4>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 20
          }
        },
        "text_VQhBG3": {
          "type": "text",
          "settings": {
            "text": "<p>Darbar needed more than four walls and a mic. They wanted:</p><p></p><p>༶ A <strong>visually strong podcast backdrop</strong> that worked with a multi-camera set up</p><p>༶ A room with <strong>excellent acoustic control without compromising aesthetics</strong></p><p>༶ A <strong>flexible brand identity</strong> for various collaborators renting the space</p><p>༶ Seamless <strong>lighting, lockable storage integration and technology integration with a live feed to the editing suite next door</strong></p><p>We took all of the above and turned it into a stylish, sound-optimised solution.</p>",
            "text_size": 3,
            "text_style": "font-body",
            "padding_bottom": 16
          }
        }
      },
      "block_order": [
        "text_yJ7qgd",
        "text_VQhBG3"
