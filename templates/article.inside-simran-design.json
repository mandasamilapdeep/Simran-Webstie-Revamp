    "section_rich_text_7Lb9dX": {
      "type": "section-rich-text",
      "blocks": {
        "text_yJ7qgd": {
          "type": "text",
          "settings": {
            "text": "<h4>1. Meet the Faces Behind Simran Design</h4><p>I’m <strong>Simran</strong>, the founder and creative director of <strong>Simran Design Ltd</strong> <strong>- a boutique interior design studio based in Leicester. </strong>With a background in textile design, I’m driven by the transformative power of interiors. I love the challenge of translating a brand’s identity into a space that not only looks beautiful but also functions seamlessly for the people who use it.</p><p><strong>Shreya</strong>, our interior designer, specialises in CAD floor plans, technical drawings and creates stunning renders that bring our vision to life. </p><p>We work with ambitious businesses to offer <strong>bespoke concept-to-completion commercial interior design</strong> across the Midlands and remote commercial interior design internationally.</p>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 20
          }
        }
      },
