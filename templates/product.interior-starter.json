        "question_EECeGp": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "Do I have to do the fit-out with you?",
            "content": "<p>No. The PDF presentation is yours - brief your own contractor or come back to us when ready, and we can support with the fit-out. </p>",
