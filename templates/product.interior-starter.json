          "settings": {
            "default_open": false,
            "title": "Can you visit my space?",
            "content": "<p>Yes. Optional site visit and measure-up included for projects within 30 minutes of Leicester. For further afield, a small travel fee applies. We can also work entirely from your measurements, photos and floor plans if preferred.</p>",
