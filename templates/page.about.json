            "review_url": "https://maps.app.goo.gl/uhZWasu3MTJ9DJzP8"
          }
        },
        "review_cXAgzN": {
          "type": "review",
          "settings": {
            "title": "A. Madero",
            "subheading": "Maptalent UAE, Recruitment",
            "review_text": "Simran has always been the best in what she does. Expect nothing but high-level of professionalism and unique talent from her. She gives full attention in listening and learning what the clients need, executes the plan properly and exceeds expectations. Our office in JLT, Dubai is stunning because of her and all our employees are just happy to call it “second home” She is highly recommended!",
