    "text_promo_zK9JYM": {
      "type": "text-promo",
      "blocks": {
        "heading_xrGEAB": {
          "type": "heading",
          "settings": {
            "title": "",
            "text_size": 6
          }
        },
        "text_xxGBP4": {
          "type": "text",
          "settings": {
            "content": "Simran Design delivers a high-end design style with a focus on commercial interiors and an intense commitment to creating interiors with atmosphere and ambience.\n\nOur diverse set of experiences span across various project types and scales: from large technology offices in the UK to clinics in Germany, villas in Dubai and podcast studios, our passion for unique interior design extends to every endeavour.\n\nSimran Design welcome clients who similarly value the transformative power of exceptional design, and we are always open to new and exciting briefs.",
            "text_size": 4
          }
        }
      },
