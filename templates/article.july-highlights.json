    "section_rich_text_mRwGbr": {
      "type": "section-rich-text",
      "blocks": {
        "text_PFKR8W": {
          "type": "text",
          "settings": {
            "text": "<h4>3. Studio 30 Barbershop, Cambs</h4>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 20
          }
        },
        "text_PCTRHg": {
          "type": "text",
          "settings": {
            "text": "<p>We’ve completed the full design visuals for <strong>Studio 30</strong>, a barbershop in Cambridge known for its modern grooming experience. The brief focused on retaining the existing internal structure while introducing a new rear customer toilet, and a compact yet comfortable client waiting area.</p><p>Alongside the spatial improvements, we also curated new <strong>exterior signage and brand identity</strong>, ensuring Studio 30 presents a professional and cohesive look both inside and out.</p>",
            "text_size": 3,
            "text_style": "font-body",
            "padding_bottom": 16
          }
        },
        "buttons_zGB6Ry": {
