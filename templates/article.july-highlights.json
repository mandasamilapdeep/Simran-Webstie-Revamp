      "blocks": {
        "text_yJ7qgd": {
          "type": "text",
          "settings": {
            "text": "<h4>1. Sneak a Peek at maza - our first Cambridge restaurant</h4>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 20
          }
        },
        "text_VQhBG3": {
          "type": "text",
          "settings": {
            "text": "<p>July marked the site reveal of our <em>“Coming Soon”</em> and <em>“Designed by Simran Design”</em> vinyl graphics at <em><strong>Maza at Eighty-Six</strong></em>, our upcoming Pakistani restaurant concept on Mill Road, Cambridge. We’ve loved watching the vision come to life - from selecting the name, building the brand and designing the interiors concept to completion - now proudly visible on the street.</p><p>We were also on site finalising materials, inspecting tile options, and reviewing finishes - stay tuned for the next stages in this brand-led transformation.</p>",
            "text_size": 3,
            "text_style": "font-body",
            "padding_bottom": 16
          }
        }
      },
