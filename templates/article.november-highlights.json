    "section_rich_text_mRwGbr": {
      "type": "section-rich-text",
      "blocks": {
        "text_PFKR8W": {
          "type": "text",
          "settings": {
            "text": "<h4>4. <strong>Sourcing for 3 Hospitality projects with Parkside </strong></h4>",
            "text_size": 4,
            "text_style": "font-body",
            "padding_bottom": 20
          }
        },
        "text_PCTRHg": {
          "type": "text",
          "settings": {
            "text": "<p>We also took time this month to visit <strong>Parkside Architectural Tiles</strong> at their Grove Business Park showroom in Leicester, sourcing for <strong>three current hospitality projects</strong>:</p>",
